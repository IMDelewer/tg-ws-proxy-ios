+#[cfg(test)]
+mod ios_worker_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn worker_rate_limit_is_respected_and_expires() {
+        let pool = CfWorkerPool::new(CancellationToken::new());
+        let domain = "worker.example.com".to_string();
+        let error = WsError::Handshake(WsHandshakeError {
+            status_code: 429,
+            status_line: "HTTP/1.1 429 Too Many Requests".to_string(),
+            headers: [("retry-after".to_string(), "60".to_string())].into_iter().collect(),
+            location: String::new(),
+        });
+        pool.report_failure(&domain, &error).await;
+        assert!(pool.available_domains(vec![domain.clone()]).await.is_empty());
+        let until = pool.exhausted_until.lock().await[&domain];
+        assert!(until > now_monotonic() + 50.0);
+        pool.exhausted_until.lock().await.insert(domain.clone(), now_monotonic() - 1.0);
+        assert_eq!(pool.available_domains(vec![domain.clone()]).await, vec![domain.clone()]);
+        pool.report_failure(&domain, &WsError::Timeout).await;
+        assert_eq!(pool.available_domains(vec![domain.clone()]).await, vec![domain]);
+    }
+
+    #[tokio::test]
+    async fn cancelled_worker_pool_does_not_schedule_connections() {
+        let cancel = CancellationToken::new();
+        cancel.cancel();
+        let pool = Arc::new(CfWorkerPool::new(cancel));
+        pool.refill_now(2, "127.0.0.1".to_string(), vec!["worker.example.com".to_string()]).await;
+        assert!(pool.refilling.lock().await.is_empty());
+        assert!(pool.idle.lock().await.is_empty());
+    }
+}
